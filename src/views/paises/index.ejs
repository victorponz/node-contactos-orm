<%- include('../partials/header') %>

<div class="page-head">
  <h1>Países</h1>
  <a href="/paises/new" class="btn btn-primary">+ Nuevo país</a>
</div>

<% if (message) { %>
  <p class="alert alert-success"><%= message %></p>
<% } %>
<% if (error) { %>
  <p class="alert alert-error"><%= error %></p>
<% } %>

<% if (paises.length === 0) { %>
  <p class="empty">Todavía no hay países.</p>
<% } else { %>
  <table class="table">
    <thead>
      <tr><th>ID</th><th>Nombre</th><th>Provincias</th><th></th></tr>
    </thead>
    <tbody>
      <% paises.forEach((p) => { %>
        <tr>
          <td><%= p.id %></td>
          <td><%= p.nombre %></td>
          <td><a href="/provincias?pais=<%= p.id %>"><%= p.numProvincias %></a></td>
          <td class="actions">
            <a href="/paises/<%= p.id %>/edit" class="btn">Editar</a>
            <form action="/paises/<%= p.id %>/delete" method="post"
                  onsubmit="return confirm('¿Eliminar <%= p.nombre.replace(/'/g, '') %>?')">
              <button type="submit" class="btn btn-danger">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<h1><%= title %></h1>

<% if (errors.length) { %>
  <div class="alert alert-error">
    <ul>
      <% errors.forEach((e) => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form action="<%= action %>" method="post" class="form" novalidate>
  <label>
    Nombre
    <input type="text" name="name" value="<%= contact.name ?? '' %>" maxlength="100" required autofocus>
  </label>
  <label>
    Email
    <input type="email" name="email" value="<%= contact.email ?? '' %>" required>
  </label>
  <label>
    Provincia
    <select name="provinciaId">
      <option value="">— Sin provincia —</option>
      <% provincias.forEach((p) => { %>
        <option value="<%= p.id %>" <%= String(p.id) === String(contact.provinciaId) ? 'selected' : '' %>><%= p.nombre %></option>
      <% }) %>
    </select>
  </label>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="/contacts" class="btn">Cancelar</a>
  </div>
</form>

<%- include('../partials/footer') %>
